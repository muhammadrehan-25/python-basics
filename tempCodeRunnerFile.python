# ================ Bitwise Operator =================
#Bitwise And &

print("5 & 2   =",5 & 3)
print("10 & 12 =",10 & 12)

#Bitwise OR |

print("7 | 5   =",7 | 5)
print("8 | 2   =",8 | 2)

#Bitwise XOR ^

print("10 ^ 6  =",10 ^ 6)
print("9 ^ 3   =",9 ^ 3)

#Bitwise NOT~

print("~6      =",~6)
print("~9      =",~9)

#Bitwise left shift <<

print("4 << 3  =",4 << 3)
print("6 << 2  =",6 << 2)

#Bitwise right shift >>

print("5 >> 2  =",5 >> 2)
print("6 >> 2  =",6 >> 2)